from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, SetEnvironmentVariable
from launch.substitutions import LaunchConfiguration
from launch_ros.actions import Node

def generate_launch_description():
    use_sim_time = LaunchConfiguration('use_sim_time')
    
    return LaunchDescription([
        SetEnvironmentVariable('RCUTILS_LOGGING_BUFFERED_STREAM', '1'),
        
        DeclareLaunchArgument(
            'use_sim_time',
            default_value='true',
            description='Use simulation time'
        ),
        
        # Visual-Inertial Odometry (Monocular Camera + IMU)
        Node(
            package='rtabmap_odom',
            executable='rgbd_odometry',
            name='visual_odometry',
            namespace='rtabmap',
            output='screen',
            parameters=[{
                'use_sim_time': True,
                'frame_id': 'camera_rgb_optical_frame',
                'odom_frame_id': 'odom',
                'publish_tf': True,
                'wait_for_transform': 2.0,
                'approx_sync': True,
                'sync_queue_size': 200,
                'topic_queue_size': 10,
                'qos': 2,
                
                # CRITICAL: Force monocular mode - subscribe ONLY to RGB
                'subscribe_rgbd': False,
                'subscribe_rgb': True,
                'subscribe_depth': False,
                'wait_imu_to_init': True,
                
                # Odometry Strategy
                'Odom/Strategy': '0',  # Frame-to-Map (Visual)
                'Odom/ImageDecimation': '1',
                'Odom/AlignWithGround': 'false',
                'Odom/FillInfoData': 'true',
                'Odom/ResetCountdown': '1',
                
                # Visual Features
                'Vis/EstimationType': '1',  # 1=PnP for monocular
                'Vis/FeatureType': '8',  # FAST/BRIEF
                'Vis/MaxFeatures': '1000',
                'Vis/MinInliers': '15',
                'Vis/InlierDistance': '0.1',
                
                # IMU Integration
                'Imu/FilterMadgwickGain': '0.1',
                'Imu/FilterComplementaryGainAcc': '0.02',
                'Imu/FilterComplementaryBiasAlpha': '0.01',
                'Imu/OmitGravityOnOutput': 'true',
                
                # Monocular parameters
                'OdomMono/InitMinFlow': '100',
                'OdomMono/InitMinTranslation': '0.1',
                'OdomMono/MinTranslation': '0.01',
                'OdomMono/MaxVariance': '0.01',
            }],
            remappings=[
                ('rgb/image', '/camera/image_raw'),
                ('rgb/camera_info', '/camera/camera_info'),
                ('imu', '/imu_throttled'),
            ]
        ),
        
        # RTAB-Map SLAM Node
        Node(
            package='rtabmap_slam',
            executable='rtabmap',
            name='rtabmap',
            namespace='rtabmap',
            output='screen',
            parameters=[{
                'use_sim_time': True,
                'subscribe_depth': False,
                'subscribe_rgb': True,
                'subscribe_stereo': False,
                'subscribe_scan': False,
                'subscribe_rgbd': False,
                'subscribe_odom_info': True,
                'frame_id': 'camera_rgb_optical_frame',
                'map_frame_id': 'map',
                'odom_frame_id': 'odom',
                'sync_queue_size': 200,
                'topic_queue_size': 10,
                'qos': 2,
                'approx_sync': True,
                
                # Disable RGB-D mode
                'RGBD/Enabled': 'false',
                
                # Memory Management
                'Mem/IncrementalMemory': 'true',
                'Mem/InitWMWithAllNodes': 'false',
            }],
            remappings=[
                ('rgb/image', '/camera/image_raw'),
                ('rgb/camera_info', '/camera/camera_info'),
                ('odom', '/rtabmap/odom'),
            ],
            arguments=['--delete_db_on_start']
        ),
    ])
